#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
scratch=$(mktemp -d)
trap 'rm -rf "$scratch"' EXIT
cat > "$scratch/module.modulemap" <<'MAP'
module SQLite3 [system] { header "shim.h" link "sqlite3" export * }
MAP
echo '#include <sqlite3.h>' > "$scratch/shim.h"
swiftc -emit-module -emit-library -module-name BreakClock Core/Sources/BreakClock/*.swift -o "$scratch/libBreakClock.so"
swiftc -I "$scratch" -L "$scratch" -lBreakClock -Xlinker -rpath -Xlinker "$scratch" \
    Sources/Social/Community.swift Sources/Social/CommunityDB.swift Tests/Database/main.swift -o "$scratch/check"
"$scratch/check"
